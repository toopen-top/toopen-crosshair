msgstr "十字的总长度（像素）"

#: ext/prefs-ui.js:126
msgid "Thickness"
msgstr "线宽"

#: ext/prefs-ui.js:127
msgid "Center gap"
msgstr "中心空隙"

#: ext/prefs-ui.js:127
msgid "Empty space in the middle to keep the target visible"
msgstr "中心留空，便于看清目标"

#: ext/prefs-ui.js:128
msgid "Center dot"
msgstr "中心点"

#: ext/prefs-ui.js:128
msgid "Add a solid dot in the exact center"
msgstr "在正中央补一个实心点"

#: ext/prefs-ui.js:129
msgid "Dot size"
msgstr "中心点大小"

#: ext/prefs-ui.js:130
