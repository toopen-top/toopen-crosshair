msgstr "显示准星"

#: ext/prefs-ui.js:119
msgid "Default shortcut: Super+C"
msgstr "默认快捷键 Super+C"

#: ext/prefs-ui.js:120
msgid "Toggle shortcut"
msgstr "开关快捷键"

#: ext/prefs-ui.js:120
msgid "Press keys to record, Backspace to clear"
msgstr "按下要设置的组合键，按退格键清空"

#: ext/prefs-ui.js:104
msgid "Press a shortcut…"
msgstr "按下快捷键…"

#: ext/prefs-ui.js:124
msgid "Shape"
msgstr "形状"

#: ext/prefs-ui.js:125
msgid "Length"
msgstr "长度"

#: ext/prefs-ui.js:125
